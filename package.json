{
  "name": "baymax-cafe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval": "tsx src/eval/cli.ts",
    "typecheck": "tsc -b --noEmit",
    "eval:long": "BAYMAX_LAYOUT=long tsx src/eval/cli.ts",
    "test:long": "BAYMAX_LAYOUT=long vitest run",
    "blockout": "BAYMAX_LAYOUT=long tsx src/eval/blockout.ts docs/blockout-long.svg"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.58.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
