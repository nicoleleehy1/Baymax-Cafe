{
  "name": "baymax-cafe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval": "tsx src/eval/cli.ts",
    "typecheck": "tsc -b --noEmit",
    "eval:long": "BAYMAX_LAYOUT=long tsx src/eval/cli.ts",
    "test:long": "BAYMAX_LAYOUT=long vitest run",
    "blockout": "BAYMAX_LAYOUT=long tsx src/eval/blockout.ts docs/blockout-long.svg",
    "eval:cass": "BAYMAX_LAYOUT=cass tsx src/eval/cli.ts",
    "test:cass": "BAYMAX_LAYOUT=cass vitest run",
    "eval:hiro": "BAYMAX_LAYOUT=hiro tsx src/eval/cli.ts",
    "test:hiro": "BAYMAX_LAYOUT=hiro vitest run",
    "eval:transfer": "tsx src/eval/transfer.ts",
    "eval:all": "npm run eval && npm run eval:long && npm run eval:cass && npm run eval:hiro && npm run eval:transfer",
    "neural:collect": "for l in classic long cass hiro; do BAYMAX_LAYOUT=$l tsx src/learning/neural/collect.ts 16 || exit 1; done",
    "neural:train": "npm run neural:collect && tsx src/learning/neural/train.ts && tsx src/learning/neural/buildReplay.ts",
    "eval:neural": "npm run neural:collect && tsx src/learning/neural/evalAll.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.58.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
